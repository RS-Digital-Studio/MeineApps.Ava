<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SmartMeasure.Shared.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:models="using:SmartMeasure.Shared.Models"
             xmlns:labs="using:Avalonia.Labs.Controls"
             xmlns:loc="using:MeineApps.Core.Ava.Localization"
             x:Class="SmartMeasure.Shared.Views.GardenPlanView"
             x:CompileBindings="True"
             x:DataType="vm:GardenPlanViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Werkzeug-Toolbar oben -->
        <Border Grid.Row="0" Background="{DynamicResource BgSecondaryBrush}" Padding="8,4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <!-- CommandParameter bleibt der GardenElementType-Name (Enum-Parse im VM) —
                         nur die ANZEIGE ist lokalisiert. -->
                    <Button Padding="8,6" CornerRadius="6" ToolTip.Tip="{loc:Translate Path}"
                            Background="{DynamicResource BgCardBrush}"
                            Command="{Binding SelectToolCommand}" CommandParameter="Weg">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <mi:MaterialIcon Kind="Road" Width="16" Height="16" Foreground="#78909C" />
                            <TextBlock Text="{loc:Translate Path}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Padding="8,6" CornerRadius="6" ToolTip.Tip="{loc:Translate Bed}"
                            Background="{DynamicResource BgCardBrush}"
                            Command="{Binding SelectToolCommand}" CommandParameter="Beet">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <mi:MaterialIcon Kind="Flower" Width="16" Height="16" Foreground="#6D4C41" />
                            <TextBlock Text="{loc:Translate Bed}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Padding="8,6" CornerRadius="6" ToolTip.Tip="{loc:Translate Lawn}"
                            Background="{DynamicResource BgCardBrush}"
                            Command="{Binding SelectToolCommand}" CommandParameter="Rasen">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <mi:MaterialIcon Kind="Grass" Width="16" Height="16" Foreground="#66BB6A" />
                            <TextBlock Text="{loc:Translate Lawn}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Padding="8,6" CornerRadius="6" ToolTip.Tip="{loc:Translate GardenWall}"
                            Background="{DynamicResource BgCardBrush}"
                            Command="{Binding SelectToolCommand}" CommandParameter="Mauer">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <mi:MaterialIcon Kind="Wall" Width="16" Height="16" Foreground="#EF5350" />
                            <TextBlock Text="{loc:Translate GardenWall}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Padding="8,6" CornerRadius="6" ToolTip.Tip="{loc:Translate Fence}"
                            Background="{DynamicResource BgCardBrush}"
                            Command="{Binding SelectToolCommand}" CommandParameter="Zaun">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <mi:MaterialIcon Kind="Fence" Width="16" Height="16" Foreground="#EF5350" />
                            <TextBlock Text="{loc:Translate Fence}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Padding="8,6" CornerRadius="6" ToolTip.Tip="{loc:Translate Terrace}"
                            Background="{DynamicResource BgCardBrush}"
                            Command="{Binding SelectToolCommand}" CommandParameter="Terrasse">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <mi:MaterialIcon Kind="ViewDashboard" Width="16" Height="16" Foreground="#D7CCC8" />
                            <TextBlock Text="{loc:Translate Terrace}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Background="{DynamicResource BgCardBrush}" Margin="4,2" />

                    <!-- Undo letztes Element -->
                    <Button Padding="8,6" CornerRadius="6" Command="{Binding UndoCommand}"
                            IsEnabled="{Binding CanUndo}" Background="{DynamicResource BgCardBrush}"
                            ToolTip.Tip="{loc:Translate RemoveLastElement}">
                        <mi:MaterialIcon Kind="Undo" Width="16" Height="16"
                                         Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Zeichnungsmodus-Leiste (nur sichtbar wenn gezeichnet wird) -->
        <Border Grid.Row="1" Background="#2C2C3E" Padding="8,4"
                IsVisible="{Binding IsDrawing}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <!-- Aktives Werkzeug + Punktzahl -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding SelectedTool}" FontSize="11" FontWeight="SemiBold"
                               Foreground="#FFEB3B" VerticalAlignment="Center" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center">
                        <Run Text="{Binding DrawingPointCount}" />
                        <Run Text="&#160;" />
                        <Run Text="{loc:Translate PointCount}" />
                    </TextBlock>
                </StackPanel>

                <!-- Letzten Punkt entfernen -->
                <Button Grid.Column="2" Padding="8,4" CornerRadius="6" Margin="4,0"
                        Command="{Binding UndoDrawPointCommand}"
                        IsEnabled="{Binding IsDrawing}" Background="#3A3A4E"
                        ToolTip.Tip="{loc:Translate RemoveLastPoint}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="UndoVariant" Width="14" Height="14" Foreground="#FFEB3B" />
                        <TextBlock Text="{loc:Translate Point}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <!-- Fertig -->
                <Button Grid.Column="3" Padding="10,4" CornerRadius="6" Margin="4,0"
                        Command="{Binding FinishDrawingCommand}" Background="#2E7D32"
                        ToolTip.Tip="{loc:Translate FinishElement}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="Check" Width="14" Height="14" Foreground="White" />
                        <TextBlock Text="{loc:Translate Finish}" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                </Button>

                <!-- Abbrechen -->
                <Button Grid.Column="4" Padding="8,4" CornerRadius="6" Margin="4,0"
                        Command="{Binding CancelDrawingCommand}" Background="#C62828"
                        ToolTip.Tip="{loc:Translate CancelDrawing}">
                    <mi:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="White" />
                </Button>
            </Grid>
        </Border>

        <!-- SkiaSharp Canvas -->
        <Panel Grid.Row="2">
            <labs:SKCanvasView x:Name="PlanCanvas" PaintSurface="OnPaintSurface" />
        </Panel>

        <!-- Materialliste unten -->
        <Border Grid.Row="3" Background="{DynamicResource BgSecondaryBrush}"
                Padding="12,6" MaxHeight="120">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="{loc:Translate Materials}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Materials}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:MaterialEstimate">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock Text="{Binding Material}" FontSize="11"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="Bold" Margin="8,0"
                                               Foreground="{DynamicResource PrimaryBrush}">
                                        <Run Text="{Binding QuantityWithSafety, StringFormat='{}{0:F1}'}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding Unit}" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextMutedBrush}">
                        <Run Text="{loc:Translate SafetyMarginNote}" />
                    </TextBlock>

                    <!-- Plan-Kap. 5.4: Volumen-Schaetzung pro Element -->
                    <Border Background="{DynamicResource BgCardBrush}"
                            CornerRadius="6" Padding="8" Margin="0,8,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Translate VolumeEstimate}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding Elements}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:GardenElement">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                            <TextBlock Text="{Binding Notes}" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <Button Grid.Column="1" FontSize="10" Padding="6,3"
                                                    Command="{Binding $parent[ItemsControl].((vm:GardenPlanViewModel)DataContext).EstimateVolumeCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource SecondaryBrush}"
                                                    Foreground="White"
                                                    Content="{loc:Translate CalculateVolume}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="{loc:Translate DepthMeters}" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <NumericUpDown Grid.Column="1" Margin="6,0,0,0"
                                               Value="{Binding VolumeDepthMeters}"
                                               Minimum="0.05" Maximum="10.0" Increment="0.05"
                                               FormatString="F2" />
                            </Grid>
                            <TextBlock Text="{Binding VolumeResultText}" FontSize="11"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding VolumeResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{DynamicResource PrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
